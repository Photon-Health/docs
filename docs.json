{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Photon Docs",
  "colors": {
    "primary": "#1570EF",
    "light": "#53B1FD",
    "dark": "#175CD3"
  },
  "logo": {
    "light": "https://photonhealth.com/content-assets/05aac0ebb7813e0e07696ae13bd48bea.svg",
    "dark": "https://photonhealth.com/content-assets/05aac0ebb7813e0e07696ae13bd48bea.svg",
    "href": "https://photonhealth.com/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API Access",
      "href": "https://photon.health"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "patient-mutation",
              "prescription-mutation",
              "order-mutation"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Mutations",
            "pages": [
              "api/patient",
              "api/prescription",
              "api/order"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "concepts/entity-resolution",
              "untitled-page",
              "concepts/clinical-screening",
              "reference/errors",
              "reference/enums",
              "reference/pharmacy-search"
            ]
          },
          {
            "group": "Types",
            "pages": [
              "api/types/patient-types",
              "api/types/prescription-types",
              "api/types/order-types",
              "api/types/change-types",
              "api/types/pharmacy-types"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/photonhealth"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#101828"
    }
  },
  "fonts": {
    "family": "Work Sans",
    "weight": 400
  },
  "contextual": {
    "options": [
      "claude",
      "chatgpt",
      "view"
    ],
    "display": "header"
  },
  "styling": {
    "codeblocks": "dark"
  }
}
