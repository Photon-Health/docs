{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Photon Docs",
  "colors": {
    "primary": "#1570EF",
    "light": "#53B1FD",
    "dark": "#175CD3"
  },
  "logo": {
    "light": "https://photonhealth.com/content-assets/05aac0ebb7813e0e07696ae13bd48bea.svg",
    "dark": "https://photonhealth.com/content-assets/05aac0ebb7813e0e07696ae13bd48bea.svg",
    "href": "https://photonhealth.com/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Sandbox",
      "href": "https://photonhealth.com/onboard#developer"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "architecture",
              "environments",
              "authentication"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/prescribe-embed",
              "integrations/sync-patients",
              "integrations/one-click-orders",
              "integrations/agent-drafted-orders"
            ]
          }
        ]
      },
      {
        "tab": "Embed",
        "groups": [
          {
            "group": "Embed",
            "pages": [
              "embed/overview",
              "embed/react",
              "embed/iframe",
              "embed/links",
              "embed/javascript",
              "embed/styling"
            ]
          }
        ]
      },
      {
        "tab": "Network",
        "groups": [
          {
            "group": "Network",
            "pages": [
              "network/overview"
            ]
          },
          {
            "group": "GraphQL",
            "pages": [
              "network/graphql",
              "network/patient",
              "network/prescription",
              "network/order",
              "network/changes",
              "network/screening",
              "network/errors",
              "network/reference"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "network/mcp",
              "network/mcp/connect",
              "network/mcp/prescribing",
              "network/mcp/fulfillment"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/photonhealth",
      "linkedin": "https://www.linkedin.com/company/photon-health",
      "github": "https://github.com/photon-health"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#101828"
    }
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "contextual": {
    "options": [
      "claude",
      "chatgpt"
    ],
    "display": "header"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "appearance": {
    "strict": false
  },
  "description": "Photon lets prescribers in your product write, sign and send prescriptions. Embed gives you the prescribing UI; Network gives your backend and agents the API.",
  "redirects": [
    {
      "source": "/patient-mutation",
      "destination": "/network/patient"
    },
    {
      "source": "/prescription-mutation",
      "destination": "/network/prescription"
    },
    {
      "source": "/order-mutation",
      "destination": "/network/order"
    },
    {
      "source": "/api/patient",
      "destination": "/network/patient"
    },
    {
      "source": "/api/prescription",
      "destination": "/network/prescription"
    },
    {
      "source": "/api/order",
      "destination": "/network/order"
    },
    {
      "source": "/api/types/:slug*",
      "destination": "/network/reference"
    },
    {
      "source": "/untitled-page",
      "destination": "/network/changes"
    },
    {
      "source": "/concepts/entity-resolution",
      "destination": "/network/changes"
    },
    {
      "source": "/concepts/clinical-screening",
      "destination": "/network/screening"
    },
    {
      "source": "/reference/errors",
      "destination": "/network/errors"
    },
    {
      "source": "/reference/enums",
      "destination": "/network/reference"
    },
    {
      "source": "/reference/pharmacy-search",
      "destination": "/network/order#pharmacies"
    },
    {
      "source": "/integrations/embed-for-a-patient",
      "destination": "/integrations/prescribe-embed"
    },
    {
      "source": "/how-photon-works",
      "destination": "/architecture"
    }
  ]
}
